FROM golang:1.24-bookworm AS builder
WORKDIR /src
ENV GOTOOLCHAIN=auto

# Copy go module files first for better caching
COPY go-stock/go.mod go-stock/go.sum ./go-stock/
RUN cd go-stock && go mod download

# Copy source and server entry point
COPY go-stock/ ./go-stock/
COPY cmd/go-stock-server/ ./go-stock/cmd/go-stock-server/

# Build
RUN cd go-stock && CGO_ENABLED=1 GOOS=linux go build -o /bin/go-stock-server ./cmd/go-stock-server/

FROM debian:bookworm-slim
WORKDIR /app

# Install Chromium + dependencies for chromedp
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates tzdata curl \
        chromium chromium-sandbox \
        fonts-noto-cjk fonts-wqy-zenhei \
        libnss3 libatk-bridge2.0-0 libdrm2 libxkbcommon0 \
        libgbm1 libasound2 libxcomposite1 libxdamage1 \
        libxrandr2 libpango-1.0-0 libcairo2 libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Tell chromedp where to find Chromium
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDP_BROWSER_PATH=/usr/bin/chromium

ENV TZ=Asia/Shanghai

COPY --from=builder /bin/go-stock-server .
COPY go-stock/build/*.json ./build/

RUN mkdir -p /app/data /app/logs

EXPOSE 18080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:18080/api/health || exit 1

CMD ["./go-stock-server"]
